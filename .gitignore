# ==========================================
# Git Ignore - FashionStore (SI2 - 2-2026)
# ==========================================

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Pytest / Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
fashionstore_tests_*/

# Bases de datos locales y temporales
*.db
*.sqlite3
# Permitir la base de datos SQLite semilla oficial para clonado en otros entornos
!prototipo/backend/app/fashionstore_local.db
!app/fashionstore_local.db

# Almacenamiento local de respaldos en tiempo de ejecución
prototipo/backend/storage/backups/*
!prototipo/backend/storage/backups/.gitkeep

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
movil/build/
prototipo/movil/build/
prototipo/movil/.dart_tool/
*.iml

# Variables de entorno y secretos
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
prototipo/backend/.env
!.env.example
!**/.env.example

# IDEs y Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Sistema Operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Archivos temporales de Office y Scratch
~$*
scratch/
prototipo/web/cache/
* - copia.*
*-copia.*

# Antigravity & Superpowers logs y auditorías locales
.superpowers/
test_out.txt
prototipo/backend/test_out.txt

# Archivos de respaldo temporales de documentación
documentacion/*.bak*
*.bak*

# Backups pesados y bloqueos de Enterprise Architect
diagramas/*_backup*.eapx
diagramas/*backup*.eapx
*.ldb
!diagramas/diagramas1erParcial.eapx

# Angular build y caché en código fuente web
prototipo/web/.angular/
prototipo/web/dist/

# Asegurar que el bundle compilado para Render esté SIEMPRE incluido
!prototipo/backend/web_dist/
!prototipo/backend/web_dist/**
