# FashionStore - Configuración de Entorno (Plantilla de Ejemplo)
# Copia este archivo a .env y completa los valores correspondientes
PROJECT_NAME="FashionStore API"
PROJECT_VERSION="1.0.0"

# Conexión a Base de Datos PostgreSQL (Opcional: Si no se define, se usa SQLite local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fashionstore_db
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Seguridad JWT
SECRET_KEY=fashionstore_super_secret_jwt_key_cambiar_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Parámetros de Seguridad CU01 y CU03
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
OTP_EXPIRE_MINUTES=15
MAX_OTP_ATTEMPTS=3

# Correo Electrónico SMTP (Gmail - CU03 Recuperación OTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=SIGEPSI <tu_correo@gmail.com>

# Pasarela de Pagos Stripe (CU16 y CU17)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=bob
